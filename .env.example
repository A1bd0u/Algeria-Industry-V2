# ---------------------------------------------------------------------------
# Algeria Industry — variables d'environnement
# En production, stocker les secrets dans GCP Secret Manager, jamais en clair.
# ---------------------------------------------------------------------------

# URL publique du site (liens d'e-mail, canonical, sitemap). Obligatoire en production.
APP_URL=https://algeria-industry.dz
VITE_APP_URL=

# Clé de signature des sessions (au moins 32 caractères aléatoires).
# Générer avec : openssl rand -base64 48
JWT_SECRET=
# Clé de chiffrement des secrets de double authentification (32 octets, hex).
# Générer : openssl rand -hex 32. Vide = clé dérivée de JWT_SECRET (changer
# JWT_SECRET rendrait alors toutes les 2FA illisibles : préférer une clé dédiée).
MFA_ENCRYPTION_KEY=
# 2FA obligatoire pour les admins (ne mettre "false" qu'en développement)
ADMIN_MFA_REQUIRED=true

# Rate limiting partagé entre instances (Upstash Redis, API REST). Vide = mémoire
# locale, suffisant avec une seule instance Cloud Run (--max-instances=1).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (captcha)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Derrière Cloudflare : lire l'IP réelle dans CF-Connecting-IP (true/false).
# N'activer que si le service n'accepte QUE le trafic Cloudflare.
BEHIND_CLOUDFLARE=false
TRUST_PROXY_HOPS=1

# Resend (e-mails). SENDER_EMAIL doit appartenir à un domaine vérifié (SPF, DKIM, DMARC).
RESEND_API_KEY=
SENDER_EMAIL=noreply@algeria-industry.dz
# Destinataire des messages du formulaire de contact
SUPPORT_EMAIL=support@algeria-industry.dz
# Alertes internes (nouveau dossier KYC, justificatif de virement, contact sans
# SUPPORT_EMAIL) : adresses séparées par des virgules. Vide = tous les comptes admin.
ADMIN_ALERT_EMAILS=

# Tâche quotidienne POST /api/cron/daily (expiration des abonnements, rappels
# J-30 / J-7). Appelée par Cloud Scheduler avec « Authorization: Bearer <secret> ».
# Générer avec : openssl rand -hex 32. Vide = tâche désactivée (503).
CRON_SECRET=

# Traduction Gemini (optionnelle : sans clé, la traduction renvoie 503)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Observabilité
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# Mesure d'audience sans cookie (Plausible). Vide = désactivée.
# Variables lues au build (client) ET au démarrage (CSP du serveur).
VITE_PLAUSIBLE_DOMAIN=
# Script auto-hébergé éventuel (défaut : https://plausible.io/js/script.js)
VITE_PLAUSIBLE_SRC=

# Identité de l'éditeur (mentions légales). À renseigner avec les VRAIS
# identifiants de la société éditrice avant la beta.
VITE_LEGAL_COMPANY_NAME=
VITE_LEGAL_COMPANY_FORM=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_RC=
VITE_LEGAL_NIF=
VITE_LEGAL_PHONE=
VITE_LEGAL_EMAIL=
VITE_LEGAL_DPO_EMAIL=
VITE_LEGAL_DIRECTOR=
VITE_LEGAL_HOST=
# RIB affiché sur les factures d'abonnement (lu côté serveur)
LEGAL_RIB=

# Paiement en ligne CIB / Edahabia (Chargily Pay v2). Vide = virement seul.
# Clé secrète test_sk_... (tests) ou live_sk_... (production). Le webhook à
# déclarer chez Chargily est ${APP_URL}/api/payments/chargily/webhook.
CHARGILY_SECRET_KEY=
# "live" pour encaisser réellement ; toute autre valeur = environnement de test
CHARGILY_MODE=test

# Coordonnées du support affichées sur le site (vides = masquées)
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=support@algeria-industry.dz
